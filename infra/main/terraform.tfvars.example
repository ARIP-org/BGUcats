# Copy to terraform.tfvars (gitignored — never commit the real file) for a
# read-only plan from a codespace (make tf-plan). Deploys set these in
# .github/workflows/deploy.yml instead.
#
# Secrets are not variables: the bot's are in SSM and Google's client is in
# Cognito, both set with infra/scripts/set-secret.sh (docs/deploy.md).

# "production" or "staging": which account's copy (variables.tf).
environment = "production"

# The Google account seeded into the admin allowlist, so there is someone who
# can open the labeling tool and add everyone else.
bootstrap_admin_email = "you@example.com"
